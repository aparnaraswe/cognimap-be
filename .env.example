# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cognimap
DB_USER=postgres
DB_PASSWORD=yourpassword

# JWT
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRES_IN=24h

# Server
PORT=3000
NODE_ENV=development

# CORS (comma-separated allowed origins, or * for any)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ── Email (Resend — resend.com) ──────────────────────────────────────────────
# Sign up free at resend.com → Dashboard → API Keys → Create API Key
# Free tier: 3,000 emails/month, 100/day — no credit card needed
RESEND_API_KEY=re_your_api_key_here
#
# Sender address shown on all emails.
# → Use onboarding@resend.dev to test immediately (no setup needed)
# → For production: verify your own domain in Resend and use noreply@yourdomain.com
EMAIL_FROM=onboarding@resend.dev
#
# Frontend URL used in email buttons (e.g. "View Report")
APP_URL=http://localhost:5173
APP_NAME=CogniMap
